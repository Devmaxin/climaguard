# ClimaGuard — local environment template
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Project Settings -> API. `.env.local` is gitignored; never commit it.
#
# Both values below are PUBLIC by design and safe in a browser bundle. What a
# user can read or write is decided by Row Level Security, not by the key.
#
# NEVER put the service-role key (sb_secret_... / service_role) here or anywhere
# in frontend code. It bypasses Row Level Security entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
